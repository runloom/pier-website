{
  "name": "pier-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Pier 官网 — 几个 AI 终端开着，谁在等你一眼能看见",
  "scripts": {
    "dev": "astro dev",
    "brand:generate": "node scripts/generate-favicon.mjs && node scripts/generate-og.mjs",
    "test:brand": "node --test tests/brand-assets.test.mjs",
    "test:brand:dist": "node --test tests/brand-dist.test.mjs",
    "prebuild": "pnpm test:brand",
    "build": "astro build",
    "postbuild": "pnpm test:brand:dist",
    "preview": "astro preview",
    "check": "astro check && pnpm test:brand"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
