---
import { Picture } from "astro:assets";
import heroShot from "../assets/hero.png";
import { getDict, REPO, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const calloutPos = [
  "top-[10%] left-[3%] max-w-[34%]",
  "top-[58%] left-[3%] max-w-[34%]",
  "top-[11%] left-[66%] max-w-[30%]",
];
---

<section class="relative isolate overflow-hidden">
  <!-- 氛围层：航海图网格 + 泊位光 -->
  <div class="chart-grid absolute inset-0 -z-20"></div>
  <div class="berth-glow absolute inset-0 -z-10"></div>

  <div class="relative mx-auto max-w-6xl px-5 pt-20 pb-24 sm:pt-28">
    <div class="intro mx-auto flex max-w-3xl flex-col items-center text-center">
      <p
        class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-line-strong bg-panel/70 px-3.5 py-1.5 font-mono text-[11.5px] text-muted"
      >
        <span class="dot text-done"></span>
        {dict.hero.badge}
      </p>

      <h1 class="display mt-7 max-w-[20em] text-[34px] leading-[1.12] sm:text-[52px]">
        {dict.hero.title}
      </h1>

      <p class="prose-measure mt-6 break-keep text-[16.5px] text-muted leading-relaxed sm:text-lg">
        {dict.hero.sub}
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3.5">
        <a href="#download" class="btn btn-primary">
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
            <path
              d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
            ></path>
          </svg>
          {dict.hero.ctaDownload}
        </a>
        <a href={REPO} target="_blank" rel="noopener" class="btn btn-ghost">
          <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
          {dict.hero.ctaGithub}
        </a>
      </div>

      <p class="mt-5 font-mono text-[12px] text-faint">{dict.hero.hint}</p>
    </div>

    <div class="hero-shot relative mx-auto mt-16 max-w-6xl" data-hero-shot>
      <Picture
        src={heroShot}
        alt={dict.hero.shotAlt}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={82}
        widths={[720, 1080, 1440, 1920, 2400]}
        sizes="(min-width: 1152px) 1152px, 92vw"
        priority
        class="hero-shot-img relative z-10 h-auto w-full"
        pictureAttributes={{ class: "block w-full" }}
      />
      <ol class="hero-callouts pointer-events-none absolute inset-0 z-20 hidden lg:block" aria-hidden="true">
        {
          dict.hero.callouts.map((callout, i) => (
            <li
              class:list={[
                "absolute rounded-md border border-line-strong bg-panel/90 px-2.5 py-1.5 font-mono text-[12px] text-fg shadow-[var(--shadow-panel)] backdrop-blur-sm",
                calloutPos[i],
              ]}
            >
              <span class="mr-2 text-brand-ink tabular-nums">{String(i + 1).padStart(2, "0")}</span>
              {callout.label}
            </li>
          ))
        }
      </ol>
      <div
        class="-bottom-10 pointer-events-none absolute inset-x-10 h-10 rounded-[100%] bg-[radial-gradient(50%_100%_at_50%_0%,rgba(133,73,255,0.28),transparent_70%)] blur-md"
      >
      </div>
      <ol class="hero-callouts mx-auto mt-6 grid max-w-xl gap-2 lg:hidden" aria-hidden="true">
        {
          dict.hero.callouts.map((callout, i) => (
            <li class="flex items-center gap-3 rounded-lg border border-line bg-panel/70 px-3 py-2 text-[13px] text-muted">
              <span class="font-mono text-[12px] text-brand-ink tabular-nums">
                {String(i + 1).padStart(2, "0")}
              </span>
              {callout.label}
            </li>
          ))
        }
      </ol>
      <script is:inline>
        (() => {
          const shot = document.currentScript?.parentElement;
          if (!shot) return;
          const img = shot.querySelector("img");
          const ready = () => shot.classList.add("is-ready");
          if (!img) {
            ready();
            return;
          }
          if (img.complete && img.naturalWidth > 0) ready();
          else {
            img.addEventListener("load", ready, { once: true });
            img.addEventListener("error", ready, { once: true });
          }
        })();
      </script>
      <noscript>
        <style>
          .hero-shot picture,
          .hero-shot .hero-callouts {
            opacity: 1 !important;
          }
        </style>
      </noscript>
    </div>
  </div>
</section>
