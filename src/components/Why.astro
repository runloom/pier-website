---
import { getDict, type Locale } from "../i18n";
import SectionHead from "./SectionHead.astro";

interface Props {
  locale: Locale;
}

const dict = getDict(Astro.props.locale);
const { why } = dict;
---

<section id="why" class="relative">
  <div class="mx-auto max-w-6xl px-5 py-24 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-20">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <SectionHead no={why.no} label={why.label} title={why.title} lead={why.lead} />
      </div>

      <div>
        {
          why.points.map((point, i) => (
            <article
              class="group border-line border-t py-7 first:border-t-0 first:pt-0 lg:first:border-t lg:first:pt-7"
              data-reveal
              style={`--reveal-delay: ${i * 0.08}s`}
            >
              <div class="flex items-baseline gap-5">
                <span class="display-wide text-[15px] text-brand-ink tabular-nums">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="display text-[19px] transition-colors group-hover:text-brand-ink sm:text-[21px]">
                    {point.title}
                  </h3>
                  <p class="prose-measure mt-2.5 text-[14.5px] text-muted leading-relaxed">
                    {point.body}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
