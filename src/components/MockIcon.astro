---
interface Props {
  name:
    | "align-left"
    | "arrow-up"
    | "bell"
    | "chevron-down"
    | "claude"
    | "diff"
    | "fold-vertical"
    | "folder"
    | "folder-tree"
    | "git-branch"
    | "openai"
    | "plus"
    | "refresh-cw"
    | "rotate-ccw"
    | "rows-3"
    | "search"
    | "square-terminal"
    | "undo-2"
    | "x";
  class?: string;
}

const { name, class: className = "size-3.5" } = Astro.props;
const lucide = name !== "claude" && name !== "openai";
---

{
  lucide ? (
    <svg
      class={className}
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      {name === "folder" && (
        <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
      )}
      {name === "diff" && (
        <>
          <path d="M12 3v14" />
          <path d="M5 10h14" />
          <path d="M5 21h14" />
        </>
      )}
      {name === "square-terminal" && (
        <>
          <path d="m7 11 2-2-2-2" />
          <path d="M11 13h4" />
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
        </>
      )}
      {name === "folder-tree" && (
        <>
          <path d="M20 10a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-2.5a1 1 0 0 1-.8-.4l-.9-1.2A1 1 0 0 0 15 3h-2a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z" />
