---
interface Props {
  no?: string;
  label: string;
  title: string;
  lead?: string;
  center?: boolean;
}

const { no, label, title, lead, center = false } = Astro.props;
---

<div class:list={[center && "flex flex-col items-center text-center"]} data-reveal>
  <p class="section-label">
    {no && <em>{no}</em>}
    {label}
  </p>
  <h2 class="display mt-4 max-w-2xl text-[30px] leading-[1.12] sm:text-[38px]">{title}</h2>
  {lead && <p class="prose-measure mt-4 max-w-2xl text-[15.5px] text-muted leading-relaxed">{lead}</p>}
</div>
