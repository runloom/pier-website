---
import { getDict, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const dict = getDict(Astro.props.locale).a11y;
---

<button
  type="button"
  data-theme-toggle
  data-mode="system"
  data-label-light={dict.themeLight}
  data-label-dark={dict.themeDark}
  data-label-system={dict.themeSystem}
  aria-label={dict.themeToggle}
  class="inline-flex size-8 items-center justify-center rounded-full border border-transparent text-muted transition-colors hover:border-line-strong hover:text-fg"
>
  <svg data-icon="light" viewBox="0 0 24 24" class="size-[17px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.8v2.2M12 19v2.2M2.8 12h2.2M19 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"></path>
  </svg>
  <svg data-icon="dark" viewBox="0 0 24 24" class="size-[17px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.4 14.2A8.4 8.4 0 0 1 9.8 3.6a8.4 8.4 0 1 0 10.6 10.6Z"></path>
  </svg>
  <svg data-icon="system" viewBox="0 0 24 24" class="size-[17px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="4.5" width="18" height="12.5" rx="2"></rect>
    <path d="M9 20.5h6M12 17v3.5"></path>
  </svg>
</button>

<style>
  [data-theme-toggle] svg {
    display: none;
  }
  [data-theme-toggle][data-mode="light"] svg[data-icon="light"],
  [data-theme-toggle][data-mode="dark"] svg[data-icon="dark"],
  [data-theme-toggle][data-mode="system"] svg[data-icon="system"] {
    display: block;
  }
</style>

<script>
  const KEY = "pier-theme";
  const mq = window.matchMedia("(prefers-color-scheme: dark)");

  const stored = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };

  function apply() {
    const mode = stored();
    const dark = mode ? mode === "dark" : mq.matches;
    document.documentElement.classList.toggle("dark", dark);
    for (const btn of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
      const current = mode ?? "system";
      btn.dataset.mode = current;
      const label =
        current === "light"
          ? btn.dataset.labelLight
          : current === "dark"
            ? btn.dataset.labelDark
            : btn.dataset.labelSystem;
      if (label) btn.title = label;
    }
  }

  mq.addEventListener("change", () => {
    if (!stored()) apply();
  });

  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("[data-theme-toggle]");
    if (!btn) return;
    const mode = stored();
    // system → dark → light → system
    try {
      if (mode === null) localStorage.setItem(KEY, "dark");
      else if (mode === "dark") localStorage.setItem(KEY, "light");
      else localStorage.removeItem(KEY);
    } catch {}
    apply();
  });

  apply();
</script>
