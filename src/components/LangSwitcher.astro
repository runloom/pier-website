---
import { getDict, localeHome, LOCALES, LOCALE_META, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const labelByLocale: Record<Locale, string> = {
  zh: dict.a11y.langZh,
  en: dict.a11y.langEn,
  ja: dict.a11y.langJa,
  ko: dict.a11y.langKo,
};
---

<details class="group relative">
  <summary
    class="inline-flex h-8 cursor-pointer list-none items-center rounded-full border border-transparent px-2.5 font-mono text-[12px] text-muted transition-colors hover:border-line-strong hover:text-fg [&::-webkit-details-marker]:hidden"
    aria-label={dict.a11y.langMenu}
  >
    {LOCALE_META[locale].short}
  </summary>
  <div
    class="absolute top-[calc(100%+6px)] right-0 z-50 min-w-36 rounded-xl border border-line-strong bg-panel py-1 shadow-[var(--shadow-panel)]"
  >
    {
      LOCALES.map((item) => (
        <a
          href={localeHome(item)}
          data-lang-switch={item}
          aria-current={item === locale ? "page" : undefined}
          class:list={[
            "block px-3 py-1.5 text-[13px] transition-colors hover:bg-panel-2 hover:text-fg",
            item === locale ? "text-brand-ink" : "text-muted",
          ]}
        >
          {labelByLocale[item]}
        </a>
      ))
    }
  </div>
</details>
