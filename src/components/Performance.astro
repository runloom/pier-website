---
import { getDict, type Locale } from "../i18n";
import SectionHead from "./SectionHead.astro";

interface Props {
  locale: Locale;
}

const dict = getDict(Astro.props.locale);
const { performance } = dict;
---

<section id="performance" class="relative">
  <div class="mx-auto max-w-6xl px-5 py-24 sm:py-28">
    <SectionHead
      no={performance.no}
      label={performance.label}
      title={performance.title}
      lead={performance.lead}
    />

    <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- 左列：Ghostty 内核 -->
      <div data-reveal>
        <h3 class="display text-[19px]">{performance.engine.title}</h3>
        <ul class="mt-6 space-y-5">
          {
            performance.engine.points.map((point) => (
              <li class="flex gap-3.5">
                <span class="mt-[7px] size-1.5 flex-none rounded-full bg-brand" aria-hidden="true" />
                <div>
                  <p class="text-[15px] font-semibold">{point.title}</p>
                  <p class="mt-1 text-[13.5px] leading-relaxed text-muted">{point.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="mt-8 font-mono text-[12px] tracking-wide text-faint">
          {performance.engine.footnote}
        </p>
      </div>

      <!-- 右列：命令面板仿真 + 键位卡 -->
      <div data-reveal style="--reveal-delay: 0.08s">
        <h3 class="display text-[19px]">{performance.keys.title}</h3>

        <!-- 面板仿真：复刻应用内命令面板的深色形态（cmdk / rounded-3xl / p-1），
             结构与配色对齐 src/renderer/components/common/command-palette，不随站点主题翻转 -->
        <div class="pal-shell mt-6 rounded-3xl p-1 shadow-[var(--shadow-panel)]" aria-hidden="true">
          <div class="pal-input mt-1 flex h-7 items-center gap-2 rounded-2xl px-2 text-sm">
            <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <span class="pal-placeholder">{performance.keys.placeholder}</span>
          </div>
          <div class="p-1">
            {
              performance.keys.rows.map((row, i) => (
                <>
                  {(i === 0 || performance.keys.rows[i - 1].group !== row.group) && (
                    <div class="pal-group px-2 py-1.5 text-xs font-medium">{row.group}</div>
                  )}
                  <div class:list={["pal-row flex min-h-7 items-center gap-2 rounded-2xl px-2 text-sm leading-5", i === 0 && "pal-row-active"]}>
                    <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      {i === 0 && (
                        <>
                          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                          <path d="M15 3v18"></path>
                        </>
                      )}
                      {i === 1 && (
                        <>
                          <path d="M15 3h6v6"></path>
                          <path d="M9 21H3v-6"></path>
                          <path d="M21 3l-7 7"></path>
                          <path d="M3 21l7-7"></path>
                        </>
                      )}
                      {i === 2 && (
                        <>
                          <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                          <path d="M4.27 21A2 2 0 0 0 6 22h12a2 2 0 0 0 2-2V8l-6-6H6a2 2 0 0 0-2 2v4"></path>
                          <circle cx="11" cy="14.5" r="2.5"></circle>
                          <path d="M13 16.5l2 2"></path>
                        </>
                      )}
                    </svg>
                    <span class="min-w-0 flex-1 truncate">{row.title}</span>
                    <kbd class="pal-keys font-mono text-xs tracking-wider">{row.keys}</kbd>
                  </div>
                </>
              ))
            }
          </div>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-2.5 sm:grid-cols-3">
          {
            performance.keys.shortcuts.map((shortcut) => (
              <div class="rounded-lg border border-line bg-panel/55 px-3.5 py-3">
                <div class="flex gap-1">
                  {[...shortcut.keys].map((key) => (
                    <kbd class="kbd">{key}</kbd>
                  ))}
                </div>
                <p class="mt-2 text-[12.5px] text-muted">{shortcut.label}</p>
              </div>
            ))
          }
        </div>

        <p class="mt-5 text-[13px] leading-relaxed text-faint">{performance.keys.note}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* 命令面板仿真：取应用深色主题的中性令牌实测值（shadcn neutral dark），
   * 两种站点主题下保持与产品一致的观感 */
  .pal-shell {
    background: #171717; /* --popover oklch(0.205 0 0) */
  }
  .pal-input {
    background: rgba(255, 255, 255, 0.075); /* bg-input/50：白 15% 再 50% */
    color: rgba(250, 250, 250, 0.3); /* placeholder:text-foreground/30 */
  }
  .pal-input svg {
    color: #fafafa;
    opacity: 0.5;
  }
  .pal-group {
    color: #8f8f8f; /* --muted-foreground oklch(0.65 0 0) */
  }
  .pal-row {
    color: #fafafa; /* --foreground oklch(0.985 0 0) */
  }
  .pal-row svg {
    opacity: 0.7;
  }
  .pal-row-active {
    background: #222222; /* --accent oklch(0.25 0 0) */
  }
  .pal-keys {
    color: #8f8f8f;
  }
</style>

