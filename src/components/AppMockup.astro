---
import { getDict, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const mock = getDict(Astro.props.locale).mock;

const statusDot: Record<string, string> = {
  run: "text-run",
  needs: "text-needs",
  idle: "text-faint",
};
---

<!-- 对齐真实 Pier：自定义标题栏 + 文件树 | 原生终端 Tab | Git 变更审查 -->
<div class="dark relative" aria-hidden="true">
  <div
    class="relative overflow-hidden rounded-xl border border-line-strong bg-panel-2 shadow-[0_1px_0_rgba(255,255,255,0.06)_inset,0_40px_90px_-30px_rgba(3,6,16,0.85)]"
  >
    <!-- 标题栏：居中路径 + 右侧智能体计数 -->
    <div class="relative flex h-[38px] items-center border-line border-b bg-panel px-3">
      <div class="flex items-center gap-1.5">
        <span class="size-2.5 rounded-full bg-[#ff5f57]/80"></span>
        <span class="size-2.5 rounded-full bg-[#febc2e]/80"></span>
        <span class="size-2.5 rounded-full bg-[#28c840]/80"></span>
      </div>
      <span class="-translate-x-1/2 absolute left-1/2 max-w-[52%] truncate font-medium text-[11px] text-faint">
        {mock.titleBarPath}
      </span>
      <div class="ml-auto flex items-center gap-2.5">
        <span class="flex items-center gap-1 font-mono text-[11px] text-run">
          <span class="dot dot-pulse"></span>
          2
        </span>
        <span class="flex items-center gap-1 font-mono text-[11px] text-needs">
          <span class="dot"></span>
          1
        </span>
        <svg viewBox="0 0 24 24" class="size-3.5 text-faint" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M6 9a6 6 0 1 1 12 0c0 7 3 7 3 9H3c0-2 3-2 3-9" stroke-linecap="round"></path>
          <path d="M10 21h4" stroke-linecap="round"></path>
        </svg>
      </div>
    </div>

    <div class="grid grid-cols-[minmax(0,1fr)] sm:grid-cols-[168px_minmax(0,1fr)] lg:grid-cols-[168px_minmax(0,1fr)_272px]">
      <!-- 文件面板 -->
      <aside class="hidden min-w-0 border-line border-r bg-panel/70 sm:block">
        <div class="flex h-7 items-center border-line border-b px-2">
          <span class="rounded-sm bg-screen px-2 py-0.5 font-medium text-[11px] text-fg">{mock.filesTab}</span>
        </div>
        <ul class="px-1.5 py-2 font-mono text-[11px]">
          {
            mock.tree.map((node) => (
              <li
                class:list={[
                  "flex items-center gap-1 rounded-sm py-0.5 pr-1.5",
                  node.active && "bg-[rgba(133,73,255,0.16)] text-fg",
                  !node.active && "text-muted",
                ]}
                style={`padding-left: ${8 + node.indent * 12}px`}
              >
                {node.kind === "dir" ? (
                  <svg viewBox="0 0 16 16" class="size-3 text-faint" fill="currentColor">
                    <path d="M1.75 2.5A.75.75 0 0 0 1 3.25v9.5c0 .41.34.75.75.75h12.5a.75.75 0 0 0 .75-.75v-7.5a.75.75 0 0 0-.75-.75H8.06l-.72-1.06A.75.75 0 0 0 6.72 2.5H1.75Z"></path>
                  </svg>
                ) : (
                  <svg viewBox="0 0 16 16" class="size-3 text-faint" fill="currentColor">
                    <path d="M3 2.75A.75.75 0 0 1 3.75 2h5.69L13 5.56v7.69a.75.75 0 0 1-.75.75h-8.5A.75.75 0 0 1 3 13.25V2.75Z"></path>
                  </svg>
                )}
                <span class="truncate">{node.name}</span>
              </li>
            ))
          }
        </ul>
      </aside>

      <!-- 终端面板：Tab 状态点 + 原生 CLI 输出 + 增强输入 -->
      <section class="flex min-w-0 flex-col bg-screen">
        <div class="flex h-7 items-center gap-0.5 border-line border-b bg-panel/90 px-1.5">
          {
            mock.terminalTabs.map((tab, i) => (
              <span
                class:list={[
                  "relative flex h-6 items-center gap-1.5 rounded-sm px-2 font-mono text-[11px]",
                  i === 0 ? "bg-screen text-fg" : "text-faint",
                ]}
              >
                {tab.status !== "idle" && (
                  <span class:list={["dot", statusDot[tab.status], tab.status === "run" && "dot-pulse"]} />
                )}
                {tab.title}
              </span>
            ))
          }
        </div>
        <div class="min-h-[168px] flex-1 space-y-1 px-4 py-3 font-mono text-[11.5px] leading-relaxed">
          {
            mock.termLines.map((line) => {
              if (line.kind === "brand") {
                return <p class="text-brand-ink">{line.text}</p>;
              }
              if (line.kind === "tool") {
                return <p class="text-faint">{line.text}</p>;
              }
              if (line.kind === "ok") {
                return <p class="text-term-green">{line.text}</p>;
              }
              return <p class="text-muted">{line.text}</p>;
            })
          }
        </div>
        <div class="border-line border-t px-2 py-1.5">
          <div class="flex h-7 items-center rounded-full border border-line-strong bg-panel px-3 font-mono text-[11px] text-faint">
            {mock.composer}
          </div>
        </div>
        <div class="flex h-6 items-center justify-between border-line border-t bg-panel px-3 font-mono text-[10px] text-faint">
          <span class="flex items-center gap-1.5 text-run">
            <span class="dot dot-pulse"></span>
            {mock.agentRunning}
          </span>
          <span class="flex items-center gap-1">
            <svg viewBox="0 0 16 16" class="size-3" fill="currentColor">
              <path d="M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6.5A2.5 2.5 0 0 1 10 9H6a1 1 0 0 0-1 1v.628a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.492 2.492 0 0 1 6 7.5h4a1 1 0 0 0 1-1v-1.128A2.25 2.25 0 0 1 9.5 3.25ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM3.5 3.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0Z"></path>
            </svg>
            {mock.branch}
          </span>
        </div>
      </section>

      <!-- Git 变更审查：分组树 + 统一 diff + 暂存/还原 -->
      <aside class="hidden min-w-0 border-line border-l bg-panel/70 lg:block">
        <div class="flex h-7 items-center justify-between border-line border-b px-2">
          <span class="rounded-sm bg-screen px-2 py-0.5 font-medium text-[11px] text-fg">{mock.changesTab}</span>
          <span class="font-mono text-[10px] text-faint">{mock.branch}</span>
        </div>
        <p class="px-3 pt-2 font-mono text-[10px] text-faint uppercase tracking-[0.16em]">{mock.unstaged}</p>
        <ul class="px-1.5 pb-1">
          {
            mock.files.map((f) => (
              <li class:list={["rounded-sm px-2 py-1", f.active && "bg-[rgba(210,222,255,0.06)]"]}>
                <div class="flex items-center gap-2">
                  <span class="min-w-0 truncate font-mono text-[11px] text-fg">{f.name}</span>
                  <span class="ml-auto font-mono text-[10px] text-done">+{f.add}</span>
                  <span class="font-mono text-[10px] text-error">−{f.del}</span>
                </div>
                <p class="font-mono text-[10px] text-faint">{f.path}</p>
              </li>
            ))
          }
        </ul>
        <div class="border-line border-t px-2 py-2">
          <div class="mb-1.5 flex items-center justify-between">
            <p class="truncate font-mono text-[10px] text-faint">{mock.hunkHeader}</p>
            <div class="flex gap-1">
              <span class="rounded-full border border-line-strong px-2 py-0.5 font-mono text-[10px] text-muted">
                {mock.stage}
              </span>
              <span class="rounded-full border border-line-strong px-2 py-0.5 font-mono text-[10px] text-muted">
                {mock.restore}
              </span>
            </div>
          </div>
          <p class="rounded-sm bg-error/15 px-1.5 py-0.5 font-mono text-[10.5px] text-error">{mock.hunkDel}</p>
          <p class="rounded-sm bg-done/15 px-1.5 py-0.5 font-mono text-[10.5px] text-done">{mock.hunkAdd}</p>
        </div>
      </aside>
    </div>
  </div>

  <div
    class="-bottom-10 absolute inset-x-10 h-10 rounded-[100%] bg-[radial-gradient(50%_100%_at_50%_0%,rgba(133,73,255,0.28),transparent_70%)] blur-md"
  >
  </div>
</div>
