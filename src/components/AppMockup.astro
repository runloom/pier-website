                      <span class="inline-flex size-3 shrink-0 items-center justify-center rounded-[2px] bg-[#69b1ff] font-sans font-bold text-[6px] leading-none text-[#0b1220]">TS</span>
                      <span class="min-w-0 truncate">{row.name}</span>
                      <span class:list={["ml-auto font-medium text-[10px]", row.letter === "A" ? "text-done" : "text-needs"]}>
                        {row.letter}
