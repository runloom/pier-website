---
import { getDict, type Locale } from "../i18n";
import MockIcon from "./MockIcon.astro";

interface Props {
  locale: Locale;
}

const mock = getDict(Astro.props.locale).mock;
const activeChange = mock.files.find((file) => file.active) ?? mock.files[0];
const insertions = mock.files.reduce((sum, file) => sum + file.add, 0);
const deletions = mock.files.reduce((sum, file) => sum + file.del, 0);

type TreeRow =
  | { kind: "group" | "dir" | "compact"; name: string; indent: number }
  | { kind: "file"; name: string; indent: number; letter: string; active: boolean };

/** Files tree: compact folders (default on) merge src/checkout. */
const filesRows: TreeRow[] = [
  { kind: "compact", name: "src / checkout", indent: 0 },
  { kind: "file", name: "cart.ts", indent: 1, letter: "M", active: true },
  { kind: "file", name: "price.ts", indent: 1, letter: "M", active: false },
  { kind: "dir", name: "tests", indent: 0 },
  { kind: "file", name: "cart.test.ts", indent: 1, letter: "A", active: false },
  { kind: "file", name: "package.json", indent: 0, letter: "", active: false },
];

/**
 * Git review tree: group root stays its own row (flattenMinDepth=2),
 * then single-child path chains flatten to `src / checkout`.
 */
const gitRows: TreeRow[] = [
  { kind: "group", name: mock.unstaged, indent: 0 },
  { kind: "compact", name: "src / checkout", indent: 1 },
  { kind: "file", name: "cart.ts", indent: 2, letter: "M", active: true },
  { kind: "file", name: "price.ts", indent: 2, letter: "M", active: false },
  { kind: "dir", name: "tests", indent: 1 },
  { kind: "file", name: "cart.test.ts", indent: 2, letter: "A", active: false },
];

function fileKind(name: string): "ts" | "json" {
  return name.endsWith(".json") ? "json" : "ts";
}

function letterClass(letter: string): string {
  return letter === "A" ? "text-done" : "text-run";
}
---

<div class="dark relative" aria-hidden="true">
  <div
    class="relative overflow-hidden rounded-xl border border-line-strong bg-panel-2 shadow-[0_1px_0_rgba(255,255,255,0.06)_inset,0_40px_90px_-30px_rgba(3,6,16,0.85)]"
  >
    <div class="relative flex h-[38px] items-center border-line border-b bg-panel px-3">
      <div class="flex items-center gap-1.5">
        <span class="size-2.5 rounded-full bg-[#ff5f57]/80"></span>
        <span class="size-2.5 rounded-full bg-[#febc2e]/80"></span>
        <span class="size-2.5 rounded-full bg-[#28c840]/80"></span>
      </div>
      <span class="-translate-x-1/2 absolute left-1/2 max-w-[52%] truncate text-center font-medium text-[12px] text-faint">
        {mock.titleBarPath}
      </span>
      <div class="ml-auto flex items-center gap-1">
        <span class="inline-flex items-center gap-1.5 px-1.5 text-[12px]">
          <span class="flex items-center gap-1 text-run">
            <span class="size-1.5 animate-pulse rounded-full bg-current"></span>
            2
          </span>
          <span class="flex items-center gap-1 font-medium text-needs">
            <span class="size-1.5 rounded-full bg-current"></span>
            1
          </span>
        </span>
        <MockIcon name="bell" class="size-3.5 text-faint" />
      </div>
    </div>

    <div class="grid min-h-[268px] grid-cols-[minmax(0,1fr)] sm:grid-cols-[176px_minmax(0,1fr)] lg:grid-cols-[176px_minmax(0,1fr)_minmax(340px,400px)]">
      <aside class="hidden min-w-0 border-line border-r bg-panel sm:flex sm:flex-col">
        <div class="pier-tabs">
          <span class="pier-tab" data-active>
            <MockIcon name="folder" class="size-3.5 text-faint" />
            <span class="font-mono font-medium">{mock.filesTab}</span>
            <MockIcon name="x" class="ml-auto size-3 text-faint/80" />
          </span>
        </div>
        <div class="flex h-10 shrink-0 items-center gap-0.5 border-line border-b px-1.5">
          <span class="flex size-6 items-center justify-center text-faint">
            <MockIcon name="folder-tree" />
          </span>
          <span class="flex size-6 items-center justify-center text-faint">
            <MockIcon name="search" />
          </span>
          <span class="min-w-0 flex-1 truncate px-1 text-center font-mono text-[11px] text-faint">{mock.filesTab}</span>
        </div>
        <ul class="flex-1 px-1 py-1 font-mono text-[11px]">
          {
            filesRows.map((row) => (
              <li
                class:list={[
                  "flex items-center gap-1 rounded-sm py-[3px] pr-1",
                  row.kind === "file" && row.active && "bg-[rgba(133,73,255,0.16)] text-fg",
                  !(row.kind === "file" && row.active) && "text-muted",
                ]}
                style={`padding-left: ${6 + row.indent * 12}px`}
              >
                {row.kind !== "file" ? (
                  <MockIcon name="chevron-down" class="size-3 shrink-0 text-faint" />
                ) : (
                  <span class="inline-block size-3 shrink-0"></span>
                )}
                {row.kind === "file" ? (
                  fileKind(row.name) === "ts" ? (
                    <span class="inline-flex size-3.5 shrink-0 items-center justify-center rounded-[2px] bg-[#69b1ff] font-sans font-bold text-[7px] leading-none text-[#0b1220]">TS</span>
                  ) : (
                    <span class="inline-flex size-3.5 shrink-0 items-center justify-center rounded-[2px] bg-[#ffa359] font-sans font-bold text-[6px] leading-none text-[#0b1220]">{"{}"}</span>
                  )
                ) : (
                  <svg viewBox="0 0 16 16" class="size-3.5 shrink-0 text-[#ffd452]" fill="currentColor">
                    <path d="M1.75 3A.75.75 0 0 1 2.5 2.25h3.38c.2 0 .39.08.53.22l.9.9h6.44A.75.75 0 0 1 14.5 4.1v8.15a.75.75 0 0 1-.75.75H2.5A.75.75 0 0 1 1.75 12.25V3Z"></path>
                  </svg>
                )}
                {row.kind === "compact" ? (
                  <span class="min-w-0 truncate">
                    src<span class="text-faint"> / </span>checkout
                  </span>
                ) : (
                  <span class="min-w-0 truncate">{row.name}</span>
                )}
                {row.kind === "file" && row.letter && (
                  <span class:list={["ml-auto font-medium text-[10px]", letterClass(row.letter)]}>{row.letter}</span>
                )}
              </li>
            ))
          }
        </ul>
      </aside>

      <section class="relative flex min-w-0 flex-col bg-screen">
        <div class="pier-tabs">
          {
            mock.terminalTabs.map((tab, i) => (
              <span class:list={["pier-tab", i === 0 && "font-semibold"]} data-active={i === 0 || undefined} data-focus={i === 0 || undefined}>
                {i === 0 && <span class="absolute top-1/2 left-1 size-1.5 -translate-y-1/2 rounded-full bg-run"></span>}
                <span class:list={["relative flex size-3.5 items-center justify-center", i === 0 && "ml-2"]}>
                  {tab.kind === "claude" && <MockIcon name="claude" />}
                  {tab.kind === "codex" && <MockIcon name="openai" />}
                  {tab.kind === "shell" && <MockIcon name="square-terminal" />}
                  {tab.status === "needs" && (
                    <span class="absolute -right-0.5 -bottom-0.5 size-1.5 rounded-full bg-needs ring-2 ring-panel"></span>
                  )}
                </span>
                <span class="max-w-[7.5rem] truncate">{tab.title}</span>
                <MockIcon name="x" class="size-3 text-faint/70" />
              </span>
            ))
          }
        </div>
        <div class="min-h-[148px] flex-1 px-3 pt-2.5 pb-14 font-mono text-[11.5px] leading-[1.55]">
          {
            mock.termLines.map((line) => {
              if (line.kind === "dim") return <p class="text-faint">{line.text}</p>;
              if (line.kind === "tool") return <p class="text-[#7aa2f7]">{line.text}</p>;
              if (line.kind === "ok") return <p class="text-term-green">{line.text}</p>;
              if (line.kind === "prompt") {
                return (
                  <p class="mt-2 flex items-center gap-1 text-muted">
                    <span>{line.text}</span>
                    <span class="caret"></span>
                  </p>
                );
              }
              return <p class="mt-1.5 text-[#c8d0e0]">{line.text}</p>;
            })
          }
        </div>
        <div class="absolute inset-x-2 bottom-[30px] z-10">
          <div class="flex h-9 items-center gap-1 rounded-full border border-line-strong bg-panel px-1 shadow-lg">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full text-faint">
              <MockIcon name="plus" />
            </span>
            <span class="min-w-0 flex-1 truncate font-mono text-[11px] text-faint">{mock.composer}</span>
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-brand text-white">
              <MockIcon name="arrow-up" class="size-3.5" />
            </span>
          </div>
        </div>
        <div class="flex h-7 items-center justify-between border-line border-t bg-panel px-3 font-mono text-[10px] text-faint">
          <span class="flex items-center gap-1.5 text-run">
            <span class="size-1.5 animate-pulse rounded-full bg-current"></span>
            {mock.agentRunning}
          </span>
          <span class="flex items-center gap-1">
            <MockIcon name="git-branch" class="size-3" />
            {mock.branch}
          </span>
        </div>
      </section>

      <aside class="hidden min-w-0 border-line border-l bg-panel lg:flex lg:flex-col">
        <div class="pier-tabs">
          <span class="pier-tab" data-active>
            <MockIcon name="diff" class="size-3.5 text-faint" />
            <span class="font-mono font-medium">{mock.filesTab}</span>
            <span class="ml-0.5 inline-flex items-center gap-1 font-mono font-normal text-[11px] tabular-nums">
              <span class="text-done">+{insertions}</span>
              <span class="text-error">−{deletions}</span>
            </span>
            <MockIcon name="x" class="ml-auto size-3 text-faint/80" />
          </span>
        </div>
        <div class="flex h-10 shrink-0 items-center gap-0.5 border-line border-b px-1.5">
          <span class="flex size-6 items-center justify-center text-faint">
            <MockIcon name="folder-tree" />
          </span>
          <span class="flex size-6 items-center justify-center text-faint">
            <MockIcon name="search" />
          </span>
          <span class="relative ml-1 px-1 pb-1.5 font-medium text-[12px] text-fg">
            {mock.unstaged}
            <span class="absolute inset-x-0 bottom-0 h-0.5 bg-brand"></span>
          </span>
          <span class="ml-auto inline-flex items-center gap-1 font-mono text-[11px] tabular-nums">
            <span class="text-done">+{insertions}</span>
            <span class="text-error">−{deletions}</span>
          </span>
          <span class="ml-1 flex items-center text-faint">
            <MockIcon name="rows-3" />
            <MockIcon name="align-left" />
            <MockIcon name="fold-vertical" />
            <MockIcon name="refresh-cw" />
          </span>
        </div>
        <div class="grid min-h-0 flex-1 grid-cols-[148px_minmax(0,1fr)]">
          <div class="min-w-0 overflow-hidden border-line border-r py-1">
            <ul>
              {
                gitRows.map((row) => (
                  <li
                    class:list={[
                      "flex items-center gap-1 py-[2px] pr-1 text-[11px]",
                      row.kind === "file" && row.active && "bg-[rgba(210,222,255,0.08)] text-fg",
                      !(row.kind === "file" && row.active) && "text-muted",
                    ]}
                    style={`padding-left: ${6 + row.indent * 10}px`}
                  >
                    {row.kind !== "file" ? (
                      <MockIcon name="chevron-down" class="size-3 shrink-0 text-faint" />
                    ) : (
                      <span class="inline-block size-3 shrink-0"></span>
                    )}
                    {row.kind === "file" ? (
                      <span class="inline-flex size-3 shrink-0 items-center justify-center rounded-[2px] bg-[#69b1ff] font-sans font-bold text-[6px] leading-none text-[#0b1220]">TS</span>
                    ) : (
                      <svg viewBox="0 0 16 16" class="size-3 shrink-0 text-[#ffd452]" fill="currentColor">
                        <path d="M1.75 3A.75.75 0 0 1 2.5 2.25h3.38c.2 0 .39.08.53.22l.9.9h6.44A.75.75 0 0 1 14.5 4.1v8.15a.75.75 0 0 1-.75.75H2.5A.75.75 0 0 1 1.75 12.25V3Z"></path>
                      </svg>
                    )}
                    {row.kind === "compact" ? (
                      <span class="min-w-0 truncate">
                        src<span class="text-faint"> / </span>checkout
                      </span>
                    ) : (
                      <span class="min-w-0 truncate">{row.name}</span>
                    )}
                    {row.kind === "file" && (
                      <span class:list={["ml-auto font-medium text-[10px]", letterClass(row.letter)]}>{row.letter}</span>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="flex min-w-0 flex-col overflow-hidden">
            <div class="flex items-center gap-1 border-line border-b px-1.5 py-1">
              <MockIcon name="chevron-down" class="size-3 shrink-0 text-faint" />
              <span class="inline-flex size-3.5 shrink-0 items-center justify-center rounded-[2px] bg-[#69b1ff] font-sans font-bold text-[7px] leading-none text-[#0b1220]">TS</span>
              <span class="min-w-0 truncate font-mono text-[11px] text-fg">{activeChange.name}</span>
              <span class="ml-auto inline-flex shrink-0 items-center gap-1 font-mono text-[10px] tabular-nums">
                <span class="text-error">−{activeChange.del}</span>
                <span class="text-done">+{activeChange.add}</span>
              </span>
              <span class="flex shrink-0 text-faint">
                <MockIcon name="undo-2" />
                <MockIcon name="plus" />
              </span>
            </div>
            <p class="px-2 pt-1.5 font-mono text-[10px] text-faint">{mock.hunkHeader}</p>
            <div class="relative mt-1 font-mono text-[10.5px] leading-[1.55]">
              <p class="flex bg-error/15 text-error">
                <span class="w-7 shrink-0 pr-1 text-right text-[9px] text-error/70">12</span>
                <span class="min-w-0 truncate">{mock.hunkDel}</span>
              </p>
              <p class="flex bg-done/15 text-done">
                <span class="w-7 shrink-0 pr-1 text-right text-[9px] text-done/70">12</span>
                <span class="min-w-0 truncate">{mock.hunkAdd}</span>
              </p>
              <div class="absolute top-0 right-1 flex items-center gap-0.5 rounded-full bg-panel/90 px-0.5 py-0.5 shadow-sm ring-1 ring-line-strong">
                <span class="flex size-5 items-center justify-center text-faint">
                  <MockIcon name="rotate-ccw" class="size-3" />
                </span>
                <span class="flex size-5 items-center justify-center text-faint">
                  <MockIcon name="plus" class="size-3" />
                </span>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <div
    class="-bottom-10 absolute inset-x-10 h-10 rounded-[100%] bg-[radial-gradient(50%_100%_at_50%_0%,rgba(133,73,255,0.28),transparent_70%)] blur-md"
  >
  </div>
</div>

<style>
  .pier-tabs {
    display: flex;
    height: 34px;
    align-items: stretch;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
  }
  .pier-tab {
    position: relative;
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 4px;
    padding: 0 6px 0 8px;
    font-size: 12px;
    color: var(--fg-faint);
  }
  .pier-tab[data-active] {
    background: var(--panel-2);
    color: var(--fg);
  }
  .pier-tab[data-focus] {
    background: var(--screen);
  }
  .pier-tab[data-active]::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 2px;
    background: var(--fg-faint);
  }
  .pier-tab[data-focus]::before {
    background: var(--brand);
  }
</style>
