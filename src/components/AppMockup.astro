---
import { getDict, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const mock = getDict(Astro.props.locale).mock;
const activeChange = mock.files.find((file) => file.active) ?? mock.files[0];
const insertions = mock.files.reduce((sum, file) => sum + file.add, 0);
const deletions = mock.files.reduce((sum, file) => sum + file.del, 0);
const gitLetterByName = Object.fromEntries(mock.files.map((file) => [file.name, file.letter]));

type GitRow =
  | { kind: "dir"; name: string; indent: number }
  | { kind: "file"; name: string; indent: number; letter: string; active: boolean };

const gitRows: GitRow[] = [];
const seenDirs = new Set<string>();
for (const file of mock.files) {
  const parts = file.path.split("/");
  parts.forEach((part, index) => {
    const key = parts.slice(0, index + 1).join("/");
    if (!seenDirs.has(key)) {
      seenDirs.add(key);
      gitRows.push({ kind: "dir", name: part, indent: index });
    }
  });
  gitRows.push({
    kind: "file",
    name: file.name,
    indent: parts.length,
    letter: file.letter,
    active: file.active,
  });
}

function fileKind(name: string): "ts" | "json" | "file" {
  if (name.endsWith(".ts")) return "ts";
  if (name.endsWith(".json")) return "json";
  return "file";
}
