---
import { getDict, LINKS, type Locale } from "../i18n";
import SectionHead from "./SectionHead.astro";

interface Props {
  locale: Locale;
}

const dict = getDict(Astro.props.locale);
const dl = dict.download;
---

<section id="download" class="relative isolate overflow-hidden border-line border-t">
  <div class="berth-glow absolute inset-0 -z-10 rotate-180"></div>
  <div class="chart-grid absolute inset-0 -z-20 rotate-180"></div>

  <div class="mx-auto max-w-6xl px-5 py-24 sm:py-28">
    <SectionHead label={dl.label} title={dl.title} lead={dl.lead} center />

    <!-- 版本徽章：JS 从 GitHub Releases 拉取，失败保持隐藏 -->
    <p class="mt-6 text-center" data-reveal>
      <a
        href={LINKS.releases}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-line-strong bg-panel/70 px-3.5 py-1.5 font-mono text-[12px] text-muted transition-colors hover:text-fg"
      >
        <span class="dot text-done"></span>
        <span>{dl.latestPrefix}</span>
        <span data-dl-version class="text-brand-ink" hidden></span>
        <span aria-hidden="true">↗</span>
      </a>
    </p>

    <div class="mx-auto mt-10 grid max-w-2xl gap-4 sm:grid-cols-2" data-reveal>
      {
        (["arm64", "x64"] as const).map((arch) => (
          <a
            href={LINKS.latestRelease}
            data-dl={arch}
            target="_blank"
            rel="noopener"
            class="group relative overflow-hidden rounded-xl border border-line-strong bg-panel/70 p-6 transition-colors hover:border-[color-mix(in_oklab,var(--brand)_45%,var(--line-strong))]"
          >
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_60%_at_50%_0%,color-mix(in_oklab,var(--brand)_10%,transparent),transparent_70%)] opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
            <div class="relative flex items-start justify-between gap-4">
              <div>
                <p class="display text-[19px]">{arch === "arm64" ? dl.apple : dl.intel}</p>
                <p data-dl-file={arch} class="mt-1.5 break-all font-mono text-[11.5px] text-faint">
                  {dl.dmgSuffix}
                </p>
              </div>
              <svg
                viewBox="0 0 24 24"
                class="size-5 flex-none text-brand-ink transition-transform duration-200 group-hover:translate-y-0.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3.5v12M7 11l5 5 5-5M4.5 20.5h15" />
              </svg>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mx-auto mt-6 max-w-2xl space-y-2 text-center" data-reveal>
      <p class="text-[12.5px] text-faint">{dl.macOnly}</p>
      <p class="font-mono text-[11.5px] text-faint leading-relaxed">{dl.cliPathNote}</p>
    </div>

    <!-- 从源码运行 -->
    <div class="dark mx-auto mt-16 max-w-2xl" data-reveal>
      <div class="overflow-hidden rounded-xl border border-line-strong bg-screen">
        <div class="flex items-center justify-between border-line border-b bg-panel px-4 py-2.5">
          <span class="font-mono text-[11px] text-faint uppercase tracking-[0.16em]">
            {dl.sourceTitle}
          </span>
          <span class="font-mono text-[10.5px] text-faint">git · pnpm</span>
        </div>
        <div class="space-y-1.5 px-5 py-4.5 font-mono text-[12.5px] leading-relaxed">
          {
            dl.sourceLines.map((line) => (
              <p>
                <span class="select-none text-term-green">❯</span>
                <span class="ml-2 text-fg">{line}</span>
              </p>
            ))
          }
        </div>
      </div>
      <p class="mt-3 text-center font-mono text-[11.5px] text-faint">{dl.sourceReqs}</p>
    </div>
  </div>
</section>

<script>
  import { REPO_API_LATEST } from "../i18n";

  interface ReleaseInfo {
    tag: string;
    arm64?: { name: string; url: string };
    x64?: { name: string; url: string };
  }

  const CACHE_KEY = "pier-latest-release";

  function applyRelease(info: ReleaseInfo) {
    const version = document.querySelector<HTMLElement>("[data-dl-version]");
    if (version) {
      version.textContent = info.tag;
      version.hidden = false;
    }
    for (const arch of ["arm64", "x64"] as const) {
      const asset = info[arch];
      if (!asset) continue;
      const link = document.querySelector<HTMLAnchorElement>(`[data-dl="${arch}"]`);
      const file = document.querySelector<HTMLElement>(`[data-dl-file="${arch}"]`);
      if (link) link.href = asset.url;
      if (file) file.textContent = asset.name;
    }
  }

  async function fetchRelease(): Promise<ReleaseInfo | null> {
    const res = await fetch(REPO_API_LATEST, {
      headers: { Accept: "application/vnd.github+json" },
    });
    if (!res.ok) return null;
    const data = (await res.json()) as {
      tag_name?: string;
      assets?: { name: string; browser_download_url: string }[];
    };
    if (!data.tag_name) return null;
    const dmgs = (data.assets ?? []).filter((a) => a.name.endsWith(".dmg"));
    const arm = dmgs.find((a) => a.name.includes("arm64"));
    const x64 = dmgs.find((a) => !a.name.includes("arm64"));
    return {
      tag: data.tag_name,
      arm64: arm ? { name: arm.name, url: arm.browser_download_url } : undefined,
      x64: x64 ? { name: x64.name, url: x64.browser_download_url } : undefined,
    };
  }

  (async () => {
    try {
      const cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) {
        applyRelease(JSON.parse(cached) as ReleaseInfo);
        return;
      }
      const info = await fetchRelease();
      if (!info) return;
      sessionStorage.setItem(CACHE_KEY, JSON.stringify(info));
      applyRelease(info);
    } catch {
      // 静默回退：按钮保持 releases/latest 链接
    }
  })();
</script>
