---
import { getDict, localeHome, REPO, withBase, type Locale } from "../i18n";
import LangSwitcher from "./LangSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);

const nav = [
  { href: "#why", label: dict.nav.why },
  { href: "#workflow", label: dict.nav.workflow },
  { href: "#features", label: dict.nav.features },
  { href: "#cli", label: dict.nav.cli },
  { href: "#faq", label: dict.nav.faq },
];
---

<header class="sticky top-0 z-40 border-line border-b bg-bg/78 backdrop-blur-md">
  <div class="relative mx-auto flex h-14 max-w-6xl items-center gap-6 overflow-visible px-5">
    <a href={localeHome(locale)} class="flex items-center gap-2.5" aria-label="Pier">
      <img src={withBase("/mark.svg")} alt="" width="48" height="36" class="block h-9 w-auto shrink-0" />
      <span class="display-wide text-[15px] tracking-[0.16em]">PIER</span>
    </a>

    <nav class="hidden items-center gap-5 font-mono text-[13px] text-muted md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} class="transition-colors hover:text-fg">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <LangSwitcher locale={locale} />
      <ThemeToggle locale={locale} />

      <a
        href={REPO}
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="inline-flex size-8 items-center justify-center rounded-full border border-transparent text-muted transition-colors hover:border-line-strong hover:text-fg"
      >
        <svg viewBox="0 0 16 16" class="size-[17px]" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>

      <a href="#download" class="btn btn-primary ml-1.5 hidden !px-3.5 !py-2 text-[13px] sm:inline-flex">
        {dict.nav.download}
      </a>
    </div>
  </div>
</header>
