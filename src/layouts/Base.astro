---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import heroScreenshot from "../assets/hero.png";
// 预加载首屏必需的 latin 子集字体（与 CSS @font-face 指向同一文件，Vite 去重为同一产物）
import archivoLatinWoff2 from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import monoLatinWoff2 from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import {
  getDict,
  htmlLang,
  LINKS,
  localeHome,
  LOCALES,
  LOCALE_META,
  ogLocale,
  REPO,
  withBase,
  type Locale,
} from "../i18n";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** 覆盖默认 hreflang（各语言首页）；博客等独立内容用同 slug 互指 */
  hreflangUrls?: Partial<Record<Locale, string>>;
}

const { locale, title, description, hreflangUrls } = Astro.props;
const dict = getDict(locale);
const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const localeUrls = Object.fromEntries(
  LOCALES.map((item) => [item, new URL(localeHome(item), site).href])
) as Record<Locale, string>;
const alternateUrls = hreflangUrls
  ? (Object.fromEntries(
      LOCALES.map((item) => [
        item,
        hreflangUrls[item] ? new URL(hreflangUrls[item]!, site).href : undefined,
      ])
    ) as Partial<Record<Locale, string>>)
  : localeUrls;
const ogImage = new URL(withBase("/og.png"), site);
const otherLocales = LOCALES.filter((item) => item !== locale);

const screenshot = new URL(withBase(heroScreenshot.src), site);

const organization = {
  "@type": "Organization",
  name: "Runloom",
  url: site.href,
  sameAs: [REPO],
};

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Pier",
  operatingSystem: "macOS",
  applicationCategory: "DeveloperApplication",
  description: pageDescription,
  url: canonical.href,
  image: ogImage.href,
  screenshot: screenshot.href,
  featureList: dict.features.items.map((item) => item.title),
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  downloadUrl: LINKS.releases,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: organization,
  publisher: organization,
  inLanguage: LOCALES.map((item) => LOCALE_META[item].html),
});
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("pier-theme");
          const dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch {}
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#070b15" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7fb" />

    <link rel="canonical" href={canonical.href} />
    {LOCALES.filter((item) => alternateUrls[item]).map((item) => (
      <link rel="alternate" hreflang={LOCALE_META[item].hreflang} href={alternateUrls[item]} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateUrls.zh ?? localeUrls.zh} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <link rel="preload" as="font" type="font/woff2" href={archivoLatinWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={monoLatinWoff2} crossorigin />

    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase("/favicon-16.png")} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pier" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.ogAlt} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {otherLocales.map((item) => (
      <meta property="og:locale:alternate" content={ogLocale(item)} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage.href} />

    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="min-h-dvh bg-bg font-body text-fg antialiased">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-panel px-4 py-2 text-sm focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {dict.a11y.skip}
    </a>

    <Header locale={locale} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      const els = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -36px 0px" }
      );
      for (const el of els) io.observe(el);

    </script>
  </body>
</html>
