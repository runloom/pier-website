---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  BASE,
  getDict,
  htmlLang,
  LINKS,
  localeHome,
  ogLocale,
  withBase,
  type Locale,
} from "../i18n";

interface Props {
  locale: Locale;
  /** 覆盖默认 title/description（404 等页面用）。 */
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const dict = getDict(locale);
const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const zhUrl = new URL(localeHome("zh"), site);
const enUrl = new URL(localeHome("en"), site);
const ogImage = new URL(withBase("/og.png"), site);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Pier",
  operatingSystem: "macOS",
  applicationCategory: "DeveloperApplication",
  description: pageDescription,
  url: canonical.href,
  image: ogImage.href,
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  downloadUrl: LINKS.releases,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
});
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />

    <!-- 主题防闪烁：首帧前根据偏好挂 .dark -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("pier-theme");
          const dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch {}
      })();
    </script>

    <!-- 语言跟随系统：仅在中文首页、无显式偏好时跳转到 /en/；显式 URL 永远优先 -->
    <script is:inline define:vars={{ base: BASE }}>
      (() => {
        try {
          const path = window.location.pathname.replace(/\/+$/, "/");
          const zhRoot = `${base}/`;
          if (path !== zhRoot && path !== base) return;
          const stored = localStorage.getItem("pier-lang");
          if (stored === "zh") return;
          const sys = (navigator.languages?.[0] || navigator.language || "zh").toLowerCase();
          const wantEn = stored === "en" || (!stored && !sys.startsWith("zh"));
          if (wantEn) window.location.replace(`${base}/en/`);
        } catch {}
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#070b15" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7fb" />

    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl.href} />
    <link rel="alternate" hreflang="en" href={enUrl.href} />
    <link rel="alternate" hreflang="x-default" href={zhUrl.href} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <link rel="icon" type="image/svg+xml" href={withBase("/logo.svg")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pier" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.ogAlt} />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={ogLocale(locale === "zh" ? "en" : "zh")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage.href} />

    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="min-h-dvh bg-bg font-body text-fg antialiased">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-panel px-4 py-2 text-sm focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {dict.a11y.skip}
    </a>

    <Header locale={locale} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      // 滚动显现
      const els = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -36px 0px" }
      );
      for (const el of els) io.observe(el);

      // 语言切换：记住显式选择，再随链接跳转
      document.addEventListener("click", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-lang-switch]");
        if (el?.dataset.langSwitch) {
          try {
            localStorage.setItem("pier-lang", el.dataset.langSwitch);
          } catch {}
        }
      });
    </script>
  </body>
</html>
