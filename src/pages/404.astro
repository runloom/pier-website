---
import Base from "../layouts/Base.astro";
import { localeHome } from "../i18n";
---

<Base locale="zh" title="404 · Pier" description="页面不存在 / Page not found">
  <section class="relative isolate overflow-hidden">
    <div class="chart-grid absolute inset-0 -z-20"></div>
    <div class="berth-glow absolute inset-0 -z-10"></div>
    <div class="mx-auto flex min-h-[60dvh] max-w-6xl flex-col items-center justify-center px-5 py-24 text-center">
      <p class="section-label"><em>404</em>页面不存在</p>
      <h1 class="display mt-5 text-[40px] sm:text-[52px]">没有这一页</h1>
      <p class="mt-3 text-[15px] text-muted">地址不对，或页面已经挪走了 · Page not found</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={localeHome("zh")} class="btn btn-primary">中文</a>
        <a href={localeHome("en")} class="btn btn-ghost">English</a>
        <a href={localeHome("ja")} class="btn btn-ghost">日本語</a>
        <a href={localeHome("ko")} class="btn btn-ghost">한국어</a>
      </div>
    </div>
  </section>
</Base>
