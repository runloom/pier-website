---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { withBase } from "../../../i18n";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.lang === "en");
  return posts.map((post) => ({
    params: { slug: post.id.split("/")[1] },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat("en", { dateStyle: "long" });
// 同 slug 的其它语言版本（hreflang 互指，只含实际存在的版本）
const slug = post.id.split("/")[1];
const siblings = await getCollection("blog", ({ id }) => id.split("/")[1] === slug);
const hreflangUrls = Object.fromEntries(
  siblings.map((s) => [
    s.data.lang,
    withBase(s.data.lang === "zh" ? `/blog/${slug}/` : `/${s.data.lang}/blog/${slug}/`),
  ])
);
---

<Base locale="en" title={`${post.data.title} · Pier`} description={post.data.description} hreflangUrls={hreflangUrls}>
  <article class="mx-auto max-w-3xl px-5 py-16">
    <time class="font-mono text-xs text-faint">{fmt.format(post.data.pubDate)}</time>
    <h1 class="display mt-3 text-3xl leading-tight sm:text-4xl">{post.data.title}</h1>
    <div class="mt-10 prose">
      <Content />
    </div>
  </article>
</Base>
