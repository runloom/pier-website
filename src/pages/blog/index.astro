---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { withBase } from "../../i18n";

const posts = (await getCollection("blog", ({ data }) => data.lang === "zh")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = new Intl.DateTimeFormat("zh-CN", { dateStyle: "medium" });
const hreflangUrls = {
  zh: withBase("/blog/"),
  en: withBase("/en/blog/"),
  ja: withBase("/ja/blog/"),
  ko: withBase("/ko/blog/"),
};
---

<Base locale="zh" title="博客 · Pier" description="Pier 的更新日志与文章" hreflangUrls={hreflangUrls}>
  <section class="mx-auto max-w-3xl px-5 py-16">
    <p class="section-label"><em>Blog</em>更新与文章</p>
    <h1 class="display mt-4 text-3xl sm:text-4xl">Pier 博客</h1>
    <p class="mt-3 text-[15px] text-muted">版本更新、使用技巧与开发笔记。</p>

    <ul class="mt-10">
      {posts.map((post) => (
        <li>
          <a
            href={withBase(`/blog/${post.id.split("/")[1]}/`)}
            class="group block border-line border-b py-6"
          >
            <time class="font-mono text-xs text-faint">{fmt.format(post.data.pubDate)}</time>
            <h2 class="mt-1.5 text-xl font-semibold transition-colors group-hover:text-brand-ink">
              {post.data.title}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
